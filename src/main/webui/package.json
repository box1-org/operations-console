{
  "name": "operations-console-webui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": "24.22.2" },
  "scripts": {
    "gen:api": "openapi-typescript ../resources/META-INF/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run gen:api && npm run typecheck && vite build",
    "dev": "vite"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
